# 环境变量示例文件
# 复制此文件为 .env 并填入实际的 Supabase 配置

# Supabase 配置 (在 Supabase Dashboard > Settings > API 中获取)
#
# 本地开发写 https://<project-ref>.supabase.co 即可；
# **生产请写相对路径 /api/supabase**（见 apps/pwa/.env.production），
# 由同域 Worker 反代到 Supabase —— 国内网络直连 *.supabase.co 经常不可达，
# 表现为「登录一直转圈/失败」，而接口层看不出任何异常。
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 应用配置
VITE_APP_NAME=钱盒子
VITE_APP_URL=http://localhost:5173

# 后端接口地址（仅本地联调用，生产请留空）
#
# 生产：留空即可。线上 /api/* 由 functions/api/[[path]].ts 同源转发，
#       经 wrangler.toml 的 [[services]] binding (API → my-bills-api) 打到共享 Worker。
#       该 Worker 不暴露公网，浏览器全程同源、无跨域。
# 本地：`npm run dev` 时 Vite 里没有 Pages Functions，需指向本地跑起来的 Worker，
#       例如先在 jijibao/worker 里 `npx wrangler dev --port 8799`，再填下面这行。
VITE_FUNCTIONS_URL=http://localhost:8799
