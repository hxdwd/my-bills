# 环境变量示例文件
# 复制此文件为 .env 并填入实际的 Supabase 配置

# Supabase 配置 (在 Supabase Dashboard > Settings > API 中获取)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 应用配置
VITE_APP_NAME=钱盒子
VITE_APP_URL=http://localhost:5173

# 后端接口（行情/估值/财富 AI）所在的共享 Worker 地址
# 本仓库已不含 Pages Functions，/api/* 不再有同源兜底：
#   - 本地开发指向本地 Worker（如 http://localhost:8799）
#   - 生产必须在 Cloudflare Pages 环境变量里配成 Worker 正式域名（不带尾斜杠），且改完要重新部署
# 生产构建若拿不到该变量会直接失败（fail-closed），避免打出全站 404 的包。
VITE_FUNCTIONS_URL=http://localhost:8799
